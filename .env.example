# PRIVATE local only. DO NOT COMMIT .env.
HOST=127.0.0.1
PORT=3000
# Select a single AI provider. Groq has a limited free tier; no automatic fallback to OpenAI.
AI_PROVIDER=groq
# Create the Groq key at https://console.groq.com/keys; store it ONLY in Vercel / local .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional paid alternative. Used ONLY when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AGENT_CITY_ACCESS_TOKEN=REPLACE-WITH-YOUR-OWN-UNIQUE-SECRET-OF-32-OR-MORE-CHARS
MAX_RUNS_PER_DAY=15
# OPTIONAL: enables prepare -> preview -> explicit approval -> GitHub draft PR
GITHUB_OWNER=nistordaniel06-cpu
GITHUB_TOKEN=github-fine-grained-token-repositories-selected-contents-and-pull-requests-write

# OPTIONAL: enable official Freelancer.com search (read-only). OAuth token, SERVER ONLY.
# Obtain through your own Freelancer.com developer account; never paste here or in browser.
FLN_OAUTH_TOKEN=


# Optional creative text providers. Choose model IDs available in your account.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
META_API_KEY=
META_MODEL=
