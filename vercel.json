{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api(?:/.*)?$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/admin/?$",
      "dest": "/public/admin/index.html"
    },
    {
      "src": "^/admin/index\\.html$",
      "dest": "/public/admin/index.html"
    },
    {
      "src": "^/admin/admin\\.js$",
      "dest": "/public/admin/admin.js"
    },
    {
      "src": "^/$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/(multiproject\\.js|hunter-ui\\.js|deploy-check\\.txt|leads-daily\\.json)$",
      "dest": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
